#!/bin/bash

# omarchy:summary=Switch Claude or Codex accounts automatically near a limit, or only notify
# omarchy:args=<claude|codex> [manual|auto] [threshold]
# omarchy:examples=omarchy agent account mode claude auto | omarchy agent account mode claude auto 90 | omarchy agent account mode codex manual

set -uo pipefail

if [[ ${1:-} != "claude" && ${1:-} != "codex" ]]; then
  echo "Usage: omarchy-agent-account-mode <claude|codex> [manual|auto] [threshold]" >&2
  exit 1
fi

if [[ -n ${2:-} ]]; then
  omarchy-agent-account-state mode "$@" || exit 1
fi

omarchy-agent-account-state registry "$1" | jq -r '
  if .switch == "auto" then
    "\(.name) switches new sessions to the account with the most headroom at \(.threshold)%."
  else
    "\(.name) notifies at \(.threshold)% and switches when you say so."
  end'
